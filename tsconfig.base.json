{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
		"baseUrl": ".",
		"paths": {
			"@ooopsstudio/editor-contracts": ["../ooops-editor/packages/contracts/dist/index.d.ts"],
			"@ooopsstudio/ui-editor-manifests": ["packages/ui-editor-manifests/src/index.ts"],
			"@ooopsstudio/scene-core": ["packages/scene-core/src/index.ts"],
			"@ooopsstudio/scene-gpu": ["packages/scene-gpu/src/index.ts"],
			"@ooopsstudio/scene-astro": ["packages/scene-astro/src/index.ts"],
			"@ooopsstudio/scene-astro/runtime": ["packages/scene-astro/src/runtime.ts"],
			"@ooopsstudio/ui-primitives": ["packages/ui-primitives/src/index.ts"],
			"@ooopsstudio/ui-svelte": ["packages/ui-svelte/src/lib/index.ts"],
			"@ooopsstudio/ui-astro": ["packages/ui-astro/src/index.ts"]
		},
    "verbatimModuleSyntax": true,

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "newLine": "LF",

    "allowJs": false,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", "coverage"]
}
