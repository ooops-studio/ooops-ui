{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ooops.studio/editor/template-v2.json",
  "title": "Ooops Astro template editor manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "framework", "paths", "themes", "breakpoints", "providers", "routes", "components", "bindings"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "range", "output"],
      "properties": {"name": {"const": "astro"}, "range": {"type": "string"}, "output": {"const": "static"}}
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRoot", "routesRoot", "components", "designTokens", "generatedCss"],
      "properties": {
        "sourceRoot": {"type": "string"}, "routesRoot": {"type": "string"}, "components": {"type": "string"},
        "designTokens": {"type": "string"}, "generatedCss": {"type": "string"},
        "instanceOverrides": {"type": "string"}
      }
    },
    "themes": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["id", "mode"], "properties": {"id": {"type": "string"}, "mode": {"enum": ["light", "dark", "system"]}}, "additionalProperties": false}},
    "breakpoints": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "minWidth": {"type": "number"}, "maxWidth": {"type": "number"}}, "additionalProperties": false}},
    "providers": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["id", "package", "mode"], "properties": {"id": {"type": "string"}, "package": {"type": "string"}, "mode": {"const": "read-only"}}, "additionalProperties": false}},
    "routes": {"type": "array", "maxItems": 256, "items": {"type": "object", "required": ["id", "source", "pathname", "dynamic"], "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "pathname": {"type": "string", "pattern": "^/"}, "dynamic": {"type": "boolean"}}, "additionalProperties": false}},
    "components": {"type": "string"},
    "bindings": {"type": "string"}
  }
}
