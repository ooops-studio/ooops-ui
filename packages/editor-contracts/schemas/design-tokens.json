{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ooops.studio/editor/design-tokens-v2.json",
  "title": "Ooops design token manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "themes", "tokens"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"},
    "themes": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["id", "mode"], "properties": {"id": {"type": "string"}, "mode": {"enum": ["light", "dark"]}}, "additionalProperties": false}},
    "systemTheme": {"type": "string"},
    "tokens": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cssVariable", "label", "category", "type", "value", "editable"],
        "properties": {
          "id": {"type": "string"},
          "cssVariable": {"type": "string", "pattern": "^--[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "category": {"enum": ["color", "typography", "spacing", "radius", "shadow", "size", "component", "layer"]},
          "type": {"enum": ["color", "font-family", "font-weight", "integer", "length", "number", "shadow"]},
          "value": {"type": ["string", "number"]},
          "themeValues": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
          "editable": {"type": "boolean"}
        }
      }
    },
    "typographyStyles": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "role", "tokens"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "role": {"enum": ["heading", "label", "body", "custom"]},
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fontFamily": {"type": "string"},
              "fontSize": {"type": "string"},
              "fontWeight": {"type": "string"},
              "lineHeight": {"type": "string"},
              "letterSpacing": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
