---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import {resolveUiMessages, type UiMessages} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
export type TabItem = {id: string; label: string; panelId?: string; badge?: string | number; content?: string; href?: string; disabled?: boolean};
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; items: TabItem[]; activeId?: string; defaultActiveId?: string; mode?: 'panels' | 'navigation'; renderPanels?: boolean; activation?: 'automatic' | 'manual'; orientation?: 'horizontal' | 'vertical'; loop?: boolean; ariaLabel?: string; messages?: Partial<UiMessages>; class?: string};
const {id, items, activeId = items[0]?.id ?? '', defaultActiveId = activeId, mode = 'panels', renderPanels = true, activation = 'automatic', orientation = 'horizontal', loop = true, ariaLabel, messages, parts, class: className = ''} = Astro.props; const uiMessages = resolveUiMessages(messages); const config = serializeUiConfig({renderPanels, panelIds: items.map(item => item.panelId), activeId, defaultActiveId, mode, activation, orientation, loop});
---
<div  id={id} data-ooops-tabs-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-tabs', className], undefined)} data-part="root" data-mode={mode} data-orientation={orientation}>
  <div role={mode === 'panels' ? 'tablist' : undefined} aria-label={mode === 'panels' ? ariaLabel ?? uiMessages.tabs : undefined} aria-orientation={mode === 'panels' ? orientation : undefined} data-ooops-ui {...getUiPart(parts, 'list')} data-part="list">{items.map((item) => mode === 'navigation' && item.href ? <a href={item.disabled ? undefined : item.href} aria-current={item.id === activeId ? 'page' : undefined} aria-disabled={item.disabled ? 'true' : undefined} data-tab data-value={item.id} data-ooops-ui {...getUiPart(parts, 'tab')} data-part="tab">{item.label}{item.badge !== undefined ? <span data-ooops-ui {...getUiPart(parts, 'badge')} data-part="badge">{item.badge}</span> : null}</a> : <button type="button" role={mode === 'panels' ? 'tab' : undefined} id={`${id}-${item.id}-tab`} aria-controls={mode === 'panels' ? item.panelId ?? `${id}-${item.id}-panel` : undefined} aria-selected={mode === 'panels' ? item.id === activeId : undefined} disabled={item.disabled} data-tab data-value={item.id} data-ooops-ui {...getUiPart(parts, 'tab')} data-part="tab">{item.label}{item.badge !== undefined ? <span data-ooops-ui {...getUiPart(parts, 'badge')} data-part="badge">{item.badge}</span> : null}</button>)}</div>
  {mode === 'panels' && renderPanels ? items.map((item) => <section role="tabpanel" id={item.panelId ?? `${id}-${item.id}-panel`} aria-labelledby={`${id}-${item.id}-tab`} data-tab-panel data-value={item.id} data-ooops-ui {...getUiPart(parts, 'panel')} data-part="panel" hidden={item.id !== activeId}>{item.content}</section>) : null}<slot />
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installTabs} from '@ooopsstudio/ui-astro/runtime/navigation'; installTabs();</script>
