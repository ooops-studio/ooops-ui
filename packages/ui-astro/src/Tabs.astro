---
import {serializeUiConfig} from './index';
export type TabItem = {id: string; label: string; content?: string; href?: string; disabled?: boolean};
type Props = {id: string; items: TabItem[]; activeId?: string; defaultActiveId?: string; mode?: 'panels' | 'navigation'; activation?: 'automatic' | 'manual'; orientation?: 'horizontal' | 'vertical'; loop?: boolean; ariaLabel?: string; class?: string};
const {id, items, activeId = items[0]?.id ?? '', defaultActiveId = activeId, mode = 'panels', activation = 'automatic', orientation = 'horizontal', loop = true, ariaLabel = 'Tabs', class: className = ''} = Astro.props; const config = serializeUiConfig({activeId, defaultActiveId, mode, activation, orientation, loop});
---
<div class:list={['ooops-tabs', className]} id={id} data-ooops-tabs-root data-part="root" data-mode={mode} data-orientation={orientation}>
  <div role={mode === 'panels' ? 'tablist' : undefined} aria-label={ariaLabel} aria-orientation={mode === 'panels' ? orientation : undefined} data-part="list">{items.map((item) => mode === 'navigation' ? <a href={item.disabled ? undefined : item.href} aria-disabled={item.disabled ? 'true' : undefined} data-tab data-value={item.id} data-part="tab">{item.label}</a> : <button type="button" role="tab" id={`${id}-${item.id}-tab`} aria-controls={`${id}-${item.id}-panel`} aria-selected={item.id === activeId} disabled={item.disabled} data-tab data-value={item.id} data-part="tab">{item.label}</button>)}</div>
  {mode === 'panels' ? items.map((item) => <section role="tabpanel" id={`${id}-${item.id}-panel`} aria-labelledby={`${id}-${item.id}-tab`} data-tab-panel data-value={item.id} data-part="panel" hidden={item.id !== activeId}>{item.content}</section>) : null}<slot />
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installTabs} from '@ooopsstudio/ui-astro/runtime/navigation'; installTabs();</script>
