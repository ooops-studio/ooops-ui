---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import type {HTMLAttributes} from 'astro/types';
import {serializeUiConfig} from './index';
type Props = Omit<HTMLAttributes<'textarea'>, 'value' | 'type' | 'class'> & {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; ariaLabel?: string;id: string; name?: string; value?: string; defaultValue?: string; label?: string; description?: string; hint?: string; error?: string; placeholder?: string; rows?: number; minRows?: number; maxRows?: number; maxlength?: number; required?: boolean; disabled?: boolean; readonly?: boolean; autoResize?: boolean; showCount?: boolean; class?: string};
const {id, name = id, value = '', defaultValue = value, label, description, hint, error, placeholder, rows = 4, minRows = rows, maxRows = 20, maxlength, required = false, disabled = false, readonly = false, autoResize = false, showCount = false, parts, class: className = '', ariaLabel, ...native} = Astro.props;
const describedBy = [native['aria-describedby'], description && `${id}-description`, error ? `${id}-error` : hint && `${id}-hint`].filter(Boolean).join(' ') || undefined;
const config = serializeUiConfig({value, defaultValue, autoResize, minRows, maxRows});
---
<div  data-ooops-textarea-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-textarea', className], undefined)} data-part="root" data-disabled={String(disabled)} data-invalid={String(Boolean(error))}>
  {label ? <label for={id} data-ooops-ui {...getUiPart(parts, 'label')} data-part="label">{label}</label> : null}{description ? <span id={`${id}-description`} data-ooops-ui {...getUiPart(parts, 'description')} data-part="description">{description}</span> : null}
  <textarea {...native} aria-label={ariaLabel ?? native['aria-label']} {id} {name} {rows} {placeholder} {maxlength} {required} {disabled} {readonly} aria-invalid={error ? 'true' : native['aria-invalid']} aria-describedby={describedBy} data-ooops-ui {...getUiPart(parts, 'control', undefined, typeof native.style === 'string' ? native.style : undefined)} style={getUiPart(parts, 'control', undefined, typeof native.style === 'string' ? native.style : undefined).style ?? native.style} data-part="control">{value}</textarea>
  {showCount ? <span data-ooops-ui {...getUiPart(parts, 'counter')} data-part="counter" aria-live="polite">{value.length}{maxlength ? `/${maxlength}` : ''}</span> : null}
  {error ? <span id={`${id}-error`} data-ooops-ui {...getUiPart(parts, 'error')} data-part="error" aria-live="polite">{error}</span> : hint ? <span id={`${id}-hint`} data-ooops-ui {...getUiPart(parts, 'hint')} data-part="hint">{hint}</span> : null}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installTextarea} from '@ooopsstudio/ui-astro/runtime/forms'; installTextarea();</script>
