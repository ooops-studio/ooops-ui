---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import {serializeUiConfig} from './index';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; label: string; openDelayMs?: number; closeDelayMs?: number; touch?: 'disabled' | 'longpress'; portal?: boolean; class?: string};
const {id, label, openDelayMs = 500, closeDelayMs = 80, touch = 'disabled', portal = true, parts, class: className = ''} = Astro.props; const config = serializeUiConfig({id, openDelayMs, closeDelayMs, touch, portal});
---
<span  data-ooops-tooltip-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-tooltip', className], undefined)} data-part="root"><span data-ooops-ui {...getUiPart(parts, 'trigger')} data-part="trigger"><slot /></span><script is:inline type="application/json" data-ooops-ui-config set:html={config} /></span>
<span id={`${id}-tooltip`} role="tooltip" data-ooops-tooltip-content={id} data-ooops-ui {...getUiPart(parts, 'content')} data-part="content" hidden>{label}<span aria-hidden="true" data-ooops-ui {...getUiPart(parts, 'arrow')} data-part="arrow"></span></span>
<script>import {installTooltip} from '@ooopsstudio/ui-astro/runtime/overlays'; installTooltip();</script>
