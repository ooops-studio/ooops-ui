---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import {resolveUiMessages, type SliderValue, type UiMessages} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; ariaLabelledby?: string; ariaDescribedby?: string; ariaLabel?: string; name?: string; label?: string; value?: SliderValue; defaultValue?: SliderValue; min?: number; max?: number; step?: number; orientation?: 'horizontal' | 'vertical'; direction?: 'ltr' | 'rtl'; minStepsBetweenThumbs?: number; disabled?: boolean; messages?: Partial<UiMessages>; class?: string};
const {id, ariaLabelledby, ariaDescribedby, ariaLabel,  name = id, label, value = 0, defaultValue = value, min = 0, max = 100, step = 1, orientation = 'horizontal', direction = 'ltr', minStepsBetweenThumbs = 0, disabled = false, messages, parts, class: className = ''} = Astro.props;
const uiMessages = resolveUiMessages(messages);
const values = typeof value === 'number' ? [value] : value; const config = serializeUiConfig({value, defaultValue, min, max, step, orientation, direction, minStepsBetweenThumbs, disabled});
---
<div  id={id} data-ooops-slider-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-slider', className], undefined)} data-part="root" data-orientation={orientation} dir={direction}>
  {label ? <span data-ooops-ui {...getUiPart(parts, 'label')} data-part="label">{label}</span> : null}<div data-ooops-ui {...getUiPart(parts, 'track')} data-part="track"><span data-ooops-ui {...getUiPart(parts, 'range')} data-part="range"></span>{values.map((_, index) => <button aria-labelledby={ariaLabelledby} aria-describedby={ariaDescribedby} type="button" disabled={disabled} aria-label={`${ariaLabel ?? label ?? uiMessages.value} ${index + 1}`} data-ooops-ui {...getUiPart(parts, 'thumb')} data-part="thumb" data-thumb={index}></button>)}</div>
  {values.map((entry, index) => <input type="hidden" disabled={disabled} name={values.length > 1 ? `${name}[]` : name} value={entry} data-ooops-ui {...getUiPart(parts, 'input')} data-part="input" data-thumb={index} />)}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installSlider} from '@ooopsstudio/ui-astro/runtime/forms'; installSlider();</script>
