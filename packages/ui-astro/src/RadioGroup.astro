---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import type {ChoiceOption} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; ariaLabelledby?: string; ariaDescribedby?: string; ariaLabel?: string; name?: string; label?: string; value?: string; defaultValue?: string; options: ChoiceOption[]; orientation?: 'horizontal' | 'vertical'; disabled?: boolean; required?: boolean; class?: string};
const {id, ariaLabelledby, ariaDescribedby, ariaLabel,  name = id, label, value = '', defaultValue = value, options, orientation = 'vertical', disabled = false, required = false, parts, class: className = ''} = Astro.props;
const config = serializeUiConfig({value, defaultValue, options, type: 'radio'});
---
<fieldset aria-label={ariaLabel} aria-labelledby={ariaLabelledby} aria-describedby={ariaDescribedby}  id={id} data-ooops-radio-group-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-radio-group', className], undefined)} data-part="root" data-orientation={orientation} disabled={disabled}>
  {label ? <legend data-ooops-ui {...getUiPart(parts, 'label')} data-part="label">{label}</legend> : null}
  {options.map((option, index) => <label data-ooops-ui {...getUiPart(parts, 'option')} data-part="option" data-selected={String(option.value === value)} data-disabled={String(Boolean(option.disabled))}><input type="radio" required={required && index === 0} {name} value={option.value} checked={option.value === value} disabled={disabled || option.disabled} data-ooops-ui {...getUiPart(parts, 'control')} data-part="control" /><span aria-hidden="true" data-ooops-ui {...getUiPart(parts, 'indicator')} data-part="indicator"></span><span data-ooops-ui {...getUiPart(parts, 'option-copy')} data-part="option-copy"><span data-ooops-ui {...getUiPart(parts, 'option-label')} data-part="option-label">{option.label}</span>{option.description ? <small data-ooops-ui {...getUiPart(parts, 'description')} data-part="description">{option.description}</small> : null}</span></label>)}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</fieldset>
<script>import {installRadioGroup} from '@ooopsstudio/ui-astro/runtime/forms'; installRadioGroup();</script>
