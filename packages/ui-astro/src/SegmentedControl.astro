---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import type {ChoiceOption} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; ariaLabelledby?: string; ariaDescribedby?: string; ariaLabel?: string; name?: string; label?: string; value?: string; defaultValue?: string; options: ChoiceOption[]; orientation?: 'horizontal' | 'vertical'; disabled?: boolean; class?: string};
const {id, ariaLabelledby, ariaDescribedby, ariaLabel,  name = id, label, value = '', defaultValue = value, options, orientation = 'horizontal', disabled = false, parts, class: className = ''} = Astro.props;
const config = serializeUiConfig({value, defaultValue, options, type: 'segmented'});
---
<div  id={id} data-ooops-segmented-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-segmented', className], undefined)} data-part="root" data-orientation={orientation} role="radiogroup" aria-label={ariaLabel ?? label} aria-labelledby={ariaLabelledby} aria-describedby={ariaDescribedby}>
  <input type="hidden" disabled={disabled} {name} {value} data-ooops-ui {...getUiPart(parts, 'input')} data-part="input" />
  {options.map((option) => <button type="button" role="radio" aria-checked={option.value === value} value={option.value} disabled={disabled || option.disabled} data-ooops-ui {...getUiPart(parts, 'option')} data-part="option" data-selected={String(option.value === value)}><span data-ooops-ui {...getUiPart(parts, 'indicator')} data-part="indicator"></span><span data-ooops-ui {...getUiPart(parts, 'label')} data-part="label">{option.label}</span></button>)}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installSegmentedControl} from '@ooopsstudio/ui-astro/runtime/forms'; installSegmentedControl();</script>
