---
import {resolveUiMessages, type SelectOption, type UiMessages} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
type Props = {id: string; ariaLabelledby?: string; ariaDescribedby?: string; ariaLabel?: string; name?: string; label?: string; description?: string; error?: string; value?: string; defaultValue?: string; options: SelectOption[]; placeholder?: string; allowCustomValue?: boolean; clearable?: boolean; required?: boolean; disabled?: boolean; portal?: boolean; messages?: Partial<UiMessages>; class?: string};
const {id, ariaLabelledby, ariaDescribedby, ariaLabel,  name = id, label, description, error, value = '', defaultValue = value, options, placeholder, allowCustomValue = false, clearable = true, required = false, disabled = false, portal = true, messages, class: className = ''} = Astro.props;
const uiMessages = resolveUiMessages(messages); const resolvedPlaceholder = placeholder ?? uiMessages.searchOptions;
const selected = options.find((option) => option.value === value); const listboxId = `${id}-listbox`; const config = serializeUiConfig({id, value, defaultValue, options, allowCustomValue, disabled, portal});
---
<div class:list={['ooops-combobox', className]} data-ooops-combobox-root data-ooops-ui data-part="root" data-invalid={String(Boolean(error))}>
  {label ? <label for={id} data-ooops-ui data-part="label">{label}</label> : null}{description ? <span id={`${id}-description`} data-ooops-ui data-part="description">{description}</span> : null}
  <span data-ooops-ui data-part="control"><input {id} type="text" value={selected?.label ?? value} placeholder={resolvedPlaceholder} {disabled} role="combobox" aria-label={ariaLabel} aria-labelledby={ariaLabelledby} aria-describedby={[ariaDescribedby, description && `${id}-description`, error && `${id}-error`].filter(Boolean).join(' ') || undefined} aria-autocomplete="list" aria-expanded="false" aria-controls={listboxId} aria-invalid={error ? 'true' : undefined} data-ooops-ui data-part="input" />{clearable ? <button type="button" aria-label={uiMessages.clearSelection} data-ooops-ui data-part="clear">×</button> : null}<span aria-hidden="true" data-ooops-ui data-part="indicator"></span></span>
  <input type="hidden" disabled={disabled} {name} {value} {required} data-ooops-ui data-part="native-input" />{error ? <span id={`${id}-error`} data-ooops-ui data-part="error" aria-live="polite">{error}</span> : null}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<div id={listboxId} role="listbox" data-ooops-combobox-listbox={id} data-ooops-ui data-part="listbox" hidden></div>
<script>import {installCombobox} from '@ooopsstudio/ui-astro/runtime/selections'; installCombobox();</script>
