---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import {resolveUiMessages, type UiMessages} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; ariaLabelledby?: string; ariaDescribedby?: string; ariaLabel?: string; name?: string; label?: string; value?: number | null; defaultValue?: number | null; min?: number; max?: number; step?: number; clampOnBlur?: boolean; required?: boolean; disabled?: boolean; messages?: Partial<UiMessages>; class?: string};
const {id, ariaLabelledby, ariaDescribedby, ariaLabel,  name = id, label, value = null, defaultValue = value, min, max, step = 1, clampOnBlur = false, required = false, disabled = false, messages, parts, class: className = ''} = Astro.props;
const uiMessages = resolveUiMessages(messages);
const config = serializeUiConfig({value, defaultValue, min, max, step, clampOnBlur});
---
<div  data-ooops-number-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-number-input', className], undefined)} data-part="root">
  {label ? <label for={id} data-ooops-ui {...getUiPart(parts, 'label')} data-part="label">{label}</label> : null}<span data-ooops-ui {...getUiPart(parts, 'input-shell')} data-part="input-shell"><button type="button" aria-label={uiMessages.decrease} disabled={disabled} data-ooops-ui {...getUiPart(parts, 'decrement')} data-part="decrement">−</button><input aria-label={ariaLabel} aria-labelledby={ariaLabelledby} {id} {name} type="number" aria-describedby={ariaDescribedby} value={value ?? ''} {min} {max} {step} {required} {disabled} data-ooops-ui {...getUiPart(parts, 'control')} data-part="control" /><button type="button" aria-label={uiMessages.increase} disabled={disabled} data-ooops-ui {...getUiPart(parts, 'increment')} data-part="increment">+</button></span>
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installNumberInput} from '@ooopsstudio/ui-astro/runtime/forms'; installNumberInput();</script>
