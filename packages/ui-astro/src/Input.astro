---
import type {HTMLAttributes} from 'astro/types';
import {resolveUiMessages, type UiMessages} from '@ooopsstudio/ui-primitives'; import {serializeUiConfig} from './index';
type Props = Omit<HTMLAttributes<'input'>, 'value' | 'type' | 'class'> & {ariaLabel?: string;id: string; name?: string; type?: 'text' | 'email' | 'url' | 'tel' | 'password' | 'search' | 'number' | 'date' | 'datetime-local' | 'time' | 'color'; value?: string; defaultValue?: string; label?: string; description?: string; hint?: string; error?: string; placeholder?: string; required?: boolean; disabled?: boolean; readonly?: boolean; clearable?: boolean; revealable?: boolean; autocomplete?: string; min?: string | number; max?: string | number; step?: string | number; messages?: Partial<UiMessages>; class?: string};
const {id, name = id, type = 'text', value = '', defaultValue = value, label, description, hint, error, placeholder, required = false, disabled = false, readonly = false, clearable = false, revealable = false, autocomplete, min, max, step, messages, class: className = '', ariaLabel, ...native} = Astro.props;
const uiMessages = resolveUiMessages(messages);
const describedBy = [native['aria-describedby'], description && `${id}-description`, error ? `${id}-error` : hint && `${id}-hint`].filter(Boolean).join(' ') || undefined;
const config = serializeUiConfig({value, defaultValue, messages: {showPassword: uiMessages.showPassword, hidePassword: uiMessages.hidePassword}});
---
<div class:list={['ooops-input', className]} data-ooops-input-root data-ooops-ui data-part="root" data-disabled={String(disabled)} data-invalid={String(Boolean(error))}>
  {label ? <label for={id} data-ooops-ui data-part="label">{label}</label> : null}
  {description ? <span id={`${id}-description`} data-ooops-ui data-part="description">{description}</span> : null}
  <span data-ooops-ui data-part="input-shell"><slot name="prefix" /><input {...native} aria-label={ariaLabel ?? native['aria-label']} {id} {name} {type} {value} {placeholder} {required} {disabled} {readonly} {autocomplete} {min} {max} {step} aria-invalid={error ? 'true' : native['aria-invalid']} aria-describedby={describedBy} data-ooops-ui data-part="control" />
    {clearable ? <button type="button" aria-label={uiMessages.clear} disabled={disabled || readonly} data-ooops-ui data-part="clear">×</button> : null}
    {revealable && type === 'password' ? <button type="button" aria-label={uiMessages.showPassword} data-ooops-ui data-part="reveal">{uiMessages.showPassword}</button> : null}<slot name="suffix" />
  </span>
  {error ? <span id={`${id}-error`} data-ooops-ui data-part="error" aria-live="polite">{error}</span> : hint ? <span id={`${id}-hint`} data-ooops-ui data-part="hint">{hint}</span> : null}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installInput} from '@ooopsstudio/ui-astro/runtime/forms'; installInput();</script>
