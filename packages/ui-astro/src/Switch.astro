---
import {serializeUiConfig} from './index';
type Props = {id: string; name?: string; label: string; description?: string; checked?: boolean; defaultChecked?: boolean; disabled?: boolean; required?: boolean; class?: string};
const {id, name = id, label, description, checked = false, defaultChecked = checked, disabled = false, required = false, class: className = ''} = Astro.props;
const config = serializeUiConfig({checked, defaultChecked, switch: true});
---
<div class:list={['ooops-switch', className]} data-ooops-switch-root data-part="root" data-state={checked ? 'on' : 'off'}>
  <input {id} {name} type="checkbox" {checked} {disabled} {required} role="switch" aria-describedby={description ? `${id}-description` : undefined} data-part="control" /><label for={id} data-part="switch-label"><span aria-hidden="true" data-part="track"><span data-part="thumb"></span></span><span data-part="label">{label}</span></label>{description ? <span id={`${id}-description`} data-part="description">{description}</span> : null}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installSwitch} from '@ooopsstudio/ui-astro/runtime/forms'; installSwitch();</script>
