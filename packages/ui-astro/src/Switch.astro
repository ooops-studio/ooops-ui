---
import {getUiPart} from '@ooopsstudio/ui-primitives';
import {serializeUiConfig} from './index';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined; id: string; ariaLabelledby?: string; ariaDescribedby?: string; ariaLabel?: string; name?: string; label?: string; description?: string; checked?: boolean; defaultChecked?: boolean; disabled?: boolean; required?: boolean; class?: string};
const {id, ariaLabelledby, ariaDescribedby, ariaLabel,  name = id, label, description, checked = false, defaultChecked = checked, disabled = false, required = false, parts, class: className = ''} = Astro.props;
const config = serializeUiConfig({checked, defaultChecked, switch: true});
---
<div  data-ooops-switch-root data-ooops-ui {...getUiPart(parts, 'root', ['ooops-switch', className], undefined)} data-part="root" data-state={checked ? 'on' : 'off'}>
  <input aria-label={ariaLabel} aria-labelledby={ariaLabelledby} {id} {name} type="checkbox" {checked} {disabled} {required} role="switch" aria-describedby={[ariaDescribedby, description && `${id}-description`].filter(Boolean).join(' ') || undefined} data-ooops-ui {...getUiPart(parts, 'control')} data-part="control" /><label for={id} data-ooops-ui {...getUiPart(parts, 'switch-label')} data-part="switch-label"><span aria-hidden="true" data-ooops-ui {...getUiPart(parts, 'track')} data-part="track"><span data-ooops-ui {...getUiPart(parts, 'thumb')} data-part="thumb"></span></span><span data-ooops-ui {...getUiPart(parts, 'label')} data-part="label">{label}</span></label>{description ? <span id={`${id}-description`} data-ooops-ui {...getUiPart(parts, 'description')} data-part="description">{description}</span> : null}
  <script is:inline type="application/json" data-ooops-ui-config set:html={config} />
</div>
<script>import {installSwitch} from '@ooopsstudio/ui-astro/runtime/forms'; installSwitch();</script>
