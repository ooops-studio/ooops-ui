---
import {getUiPart} from '@ooopsstudio/ui-primitives';
type Props = {parts?: import('@ooopsstudio/ui-primitives').UiParts | undefined;
  part: string;
  as?: keyof HTMLElementTagNameMap;
  state?: string;
  orientation?: 'horizontal' | 'vertical';
  disabled?: boolean;
  selected?: boolean;
  active?: boolean;
  class?: string;
  [attribute: string]: unknown;
};
const {part, as: tag = 'div', state, orientation, disabled, selected, active, parts, class: className, ...attributes}: Props = Astro.props;
const Tag = tag;
---
<Tag {...attributes} {...getUiPart(parts, part, className, typeof attributes.style === 'string' ? attributes.style : undefined)} data-ooops-ui data-part={part} data-state={state} data-orientation={orientation} data-disabled={disabled === undefined ? undefined : String(disabled)} data-selected={selected === undefined ? undefined : String(selected)} data-active={active === undefined ? undefined : String(active)}><slot /></Tag>
